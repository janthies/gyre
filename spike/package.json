{
	"name": "helix-picker-spike",
	"displayName": "Helix Picker (spike)",
	"description": "Step 0: can a Helix-style picker open as a modal overlay, and how fast?",
	"publisher": "jan",
	"version": "0.0.1",
	"private": true,
	"engines": {
		"vscode": "^1.100.0"
	},
	"main": "./extension.js",
	"activationEvents": [],
	"contributes": {
		"commands": [
			{
				"command": "helixPickerSpike.openModal",
				"title": "Helix Picker Spike: Open as modal overlay"
			},
			{
				"command": "helixPickerSpike.openTab",
				"title": "Helix Picker Spike: Open as tab"
			}
		],
		"customEditors": [
			{
				"viewType": "helixPickerSpike.picker",
				"displayName": "Helix Picker",
				"selector": [
					{
						"filenamePattern": "*.helixpicker"
					}
				],
				"priority": "option"
			}
		]
	}
}
